rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each person can only see and manage their own tracks
    match /users/{uid}/tracks/{trackId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else (including the daily usage counter) is off-limits to the app.
    // The Cloud Function uses admin access, so it isn't affected by these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
