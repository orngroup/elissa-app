rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each profile's library. To add someone, add their lower-case name to the list.
    match /profiles/{profile}/tracks/{trackId} {
      allow read, write: if request.auth != null && profile in ['elissa'];
    }

    // Everything else (including the daily usage counters) is off-limits to the app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
